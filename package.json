{
  "name": "clawtrate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "scenarios": "node e2e/scenario-check.ts",
    "fixture": "pnpm --filter @clawtrate/desktop fixture",
    "visual": "playwright test -c playwright.visual.config.ts",
    "visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots=changed",
    "desktop": "pnpm --filter @clawtrate/desktop start",
    "desktop:dev": "pnpm --filter @clawtrate/desktop dev",
    "preview:web": "pnpm --filter @clawtrate/desktop preview:web",
    "package:mac": "pnpm --filter @clawtrate/desktop package:mac",
    "package:win": "pnpm --filter @clawtrate/desktop package:win",
    "test:desktop-updates": "playwright test -c playwright.updates.config.ts",
    "check:packaged": "playwright test -c playwright.packaged.config.ts",
    "release:beta": "node apps/desktop/packaging/release-beta.ts",
    "mobile:build": "node apps/mobile/scripts/build.ts",
    "mobile:check": "node apps/mobile/scripts/check.ts",
    "dev-gateway": "node tools/dev-gateway/src/cli.ts",
    "brand:icons": "node tools/brand/src/make-icons.ts",
    "brand:strip": "node tools/brand/src/strip-logo.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
