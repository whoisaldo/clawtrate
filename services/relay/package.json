{
  "name": "@clawtrate/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json",
    "start": "node src/node/main.ts",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1"
  },
  "dependencies": {
    "@clawtrate/relay-protocol": "workspace:*",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "miniflare": "5.20261104.0-beta",
    "wrangler": "4.158.0"
  }
}
